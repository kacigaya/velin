<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only. Explicit because minSdk 26 still allows cleartext by default. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
